{
  "name": "zen-recorder",
  "version": "0.3.0",
  "private": true,
  "description": "A local meeting recorder for Firefox-based browsers: Google Meet, Zoom and Microsoft Teams calls become a recording plus notes on your own disk, ready for an AI assistant to analyse, and nothing leaves the machine.",
  "license": "MIT",
  "homepage": "https://github.com/zenfully-org/zen-recorder#readme",
  "bugs": {
    "url": "https://github.com/zenfully-org/zen-recorder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenfully-org/zen-recorder.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "wxt -b firefox --mv3",
    "build": "wxt build -b firefox --mv3",
    "build:e2e": "tsx scripts/build-e2e.ts",
    "zip": "wxt zip -b firefox --mv3",
    "changelog": "tsx scripts/changelog.ts",
    "compile": "tsc --noEmit",
    "check": "pnpm check:lint && pnpm check:quality",
    "check:lint": "biome check . && tsx scripts/check-conventions.ts",
    "check:conventions": "tsx scripts/check-conventions.ts",
    "check:quality": "tsx scripts/check-quality.ts",
    "quality:report": "tsx scripts/check-quality.ts --report",
    "check:fix": "biome check --write .",
    "check:identity": "bash scripts/check-identity.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "pnpm build:e2e && tsx scripts/e2e-fixture.ts",
    "bench": "pnpm build:e2e && tsx scripts/bench-recording.ts",
    "bench:run": "tsx scripts/bench-recording.ts",
    "bench:primitives": "tsx scripts/bench-primitives.ts",
    "fixture": "tsx scripts/fixture-server.ts",
    "setup:firefox": "tsx scripts/setup-firefox.ts",
    "open:build": "tsx scripts/open-build.ts",
    "notes:schema": "tsx scripts/generate-notes-schema.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@webext-core/messaging": "4.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "idb": "8.0.3",
    "lucide-react": "1.49.0",
    "mediabunny": "1.61.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "@wxt-dev/auto-icons": "1.1.2",
    "@wxt-dev/module-react": "1.2.2",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.5",
    "jscpd": "5.4.0",
    "knip": "6.39.0",
    "puppeteer": "25.12.0",
    "tailwindcss": "4.3.3",
    "tinyglobby": "0.2.17",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "web-ext": "10.7.0",
    "wxt": "0.21.4"
  }
}
