{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!docs", "!src/test/fixtures", "!src/components/ui"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  // Biome formats Markdown and YAML since 2.6, and its formatter stays off for both. Tools write
  // much of the YAML: pnpm writes pnpm-lock.yaml in its own quotes at every install, and
  // Dependabot the workflows' action pins with their version comments. The docs keep their tables
  // in the compact form they are written in by hand. Biome still lints both languages.
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // Biome fails a check only on an error: a rule it reports as a warning or an info prints its
      // finding, and `pnpm check` passes. So each rule below that is not an error on its own is
      // raised to one, rule by rule: a level on a whole group ("style": "error") would also turn
      // on the group's rules that are not recommended. scripts/quality/biome-config.test.ts fails
      // while an enabled rule is not an error, as a rule a Biome update brings can be: raise it
      // here, or turn it off with the reason beside it. That includes the rules of the domains
      // below (noFocusedTests, noIdenticalTestTitle and noReactStringRefs are warnings of their
      // own).
      "complexity": {
        "noAdjacentSpacesInRegex": "error",
        "noArguments": "error",
        "noBannedTypes": "error",
        "noCommaOperator": "error",
        "noEmptyTypeParameters": "error",
        "noExtraBooleanCast": "error",
        "noFlatMapIdentity": "error",
        "noImportantStyles": "error",
        "noStaticOnlyClass": "error",
        "noThisInStatic": "error",
        "noUselessCatch": "error",
        "noUselessConstructor": "error",
        "noUselessContinue": "error",
        "noUselessEmptyExport": "error",
        "noUselessEscapeInRegex": "error",
        "noUselessFragments": "error",
        "noUselessLabel": "error",
        "noUselessLoneBlockStatements": "error",
        "noUselessRename": "error",
        "noUselessStringRaw": "error",
        "noUselessSwitchCase": "error",
        "noUselessTernary": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error",
        "noUselessUndefinedInitialization": "error",
        // Asks for an arrow function wherever a function expression does not use `this`. The code
        // replaces browser methods and constructors with function expressions (the media
        // elements' `srcObject` setter, `MediaRecorder.prototype.start` in a test), which keep
        // `this` and `new` like what they replace; an arrow function has neither.
        "useArrowFunction": "off",
        "useDateNow": "error",
        "useFlatMap": "error",
        "useIndexOf": "error",
        // Asks for `process.env.NAME`, and TypeScript's `noPropertyAccessFromIndexSignature`
        // (tsconfig.json) asks for `process.env['NAME']`: a key the type does not declare is
        // written in brackets, which shows that it may be missing.
        "useLiteralKeys": "off",
        "useMathMinMax": "error",
        "useNumericLiterals": "error",
        "useOptionalChain": "error",
        "useRegexLiterals": "error",
        "useSimpleNumberKeys": "error"
      },
      "correctness": {
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error",
        "useParseIntRadix": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noDynamicNamespaceImportAccess": "error",
        "useDomNodeTextContent": "error"
      },
      "style": {
        "noDescendingSpecificity": "error",
        "noNonNullAssertion": "error",
        "useArrayLiterals": "error",
        "useConst": "error",
        "useDeprecatedReason": "error",
        "useExponentiationOperator": "error",
        "useExportType": "error",
        "useImportType": "error",
        "useLiteralEnumMembers": "error",
        "useNodejsImportProtocol": "error",
        "useShorthandFunctionType": "error",
        "useTemplate": "error"
      },
      "suspicious": {
        "noApproximativeNumericConstant": "error",
        "noCatchAssign": "error",
        "noConfusingLabels": "error",
        "noConfusingVoidType": "error",
        "noConstEnum": "error",
        "noDeprecatedMediaType": "error",
        "noDocumentCookie": "error",
        "noDuplicateEnumValues": "error",
        "noDuplicateFields": "error",
        "noEmptyBlock": "error",
        "noExplicitAny": "error",
        "noExtraNonNullAssertion": "error",
        "noFocusedTests": "error",
        "noGlobalIsFinite": "error",
        "noGlobalIsNan": "error",
        "noIdenticalTestTitle": "error",
        "noIrregularWhitespace": "error",
        "noOctalEscape": "error",
        "noProto": "error",
        "noPrototypeBuiltins": "error",
        "noQuickfixBiome": "error",
        "noReactStringRefs": "error",
        "noRedundantUseStrict": "error",
        "noSuspiciousSemicolonInJsx": "error",
        "noTemplateCurlyInString": "error",
        "noTsIgnore": "error",
        "noUselessEscapeInString": "error",
        "noUselessRegexBackrefs": "error",
        "useAdjacentOverloadSignatures": "error",
        "useBiomeIgnoreFolder": "error",
        "useDefaultSwitchClauseLast": "error",
        "useGoogleFontDisplay": "error",
        "useIsArray": "error"
      }
    },
    // A domain's recommended rules are on for the packages package.json names (react, tailwindcss
    // and vitest here) whether or not they are named, and `biome rage` lists none of them. Named
    // here, they are what scripts/quality/biome-config.test.ts reads, with each domain's rules from
    // scripts/quality/biome-rules.json; the test fails when package.json names a package of a
    // domain this list does not name.
    "domains": {
      "react": "recommended",
      "tailwind": "recommended",
      "test": "recommended"
    }
  },
  "overrides": [
    {
      // noComponentHookFactories reads a capitalised function declared inside another function
      // as a React component that each call makes anew. Outside the React pages it finds only
      // test doubles that stand in for a constructor (`function FakePeerConnection() {}` inside the
      // factory that builds a fake window), where a new one per call is the point. The React code
      // is in src/entrypoints/ and src/components/, and the rule stays on there.
      "includes": ["**", "!src/entrypoints/**", "!src/components/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
